local teleportPage = createPage("Teleport")
label(teleportPage, "📍 TELEPORT ENGINE")

local function teleportToPart(name)
    local char = player.Character or player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 5)

    if not root then return end

    local target = workspace:FindFirstChild(name, true)
    if target then
        if target:IsA("BasePart") then
            root.CFrame = target.CFrame + Vector3.new(0, 4, 0)
        elseif target:IsA("Model") then
            local part = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
            if part then
                root.CFrame = part.CFrame + Vector3.new(0, 4, 0)
            end
        end
    end
end

